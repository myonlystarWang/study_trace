# ==============================================================================
# 智学迹 StudyTrace 环境变量配置模版
# 部署/换机使用说明：
# 1. 复制本文件到 data/.env （或项目根目录 .env）
# 2. 将下方的占位符替换为您个人的真实 Key
# 3. 注意：切勿将包含真实凭证的 .env 提交到公开代码仓库！
# ==============================================================================

# [安全与会话密钥]
# 留空时系统首次启动会自动生成 32 字节随机高强度 Key
SECRET_KEY=your_random_secret_key_here

# [大模型 OCR 识题 Key]
# 智谱 BigModel 开放平台 API Key（用于拍照批量切题与公式 LaTeX 提取）
OCR_CLOUD_API_KEY=your_glm_or_cloud_api_key_here

# [微信公众号接口测试号推送与交互]
# 微信公众平台接口测试账号申请：https://mp.weixin.qq.com/debug/cgi-bin/sandbox?t=sandbox/login
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_TEMPLATE_ID=your_wechat_template_id
# 接收推送的家长 OpenID（多个逗号隔开）
WECHAT_OPEN_IDS=openid_1,openid_2
# 微信服务器消息回调验证 Token
WECHAT_CALLBACK_TOKEN=studytrace2026

# [WxPusher 微信消息通知备用通道]
# WxPusher 官网：https://wxpusher.zjiecode.com/
WXPUSHER_APP_TOKEN=your_wxpusher_app_token
WXPUSHER_TOPIC_ID=your_wxpusher_topic_id
